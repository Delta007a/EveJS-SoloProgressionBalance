{
  "schemaVersion": 3,
  "id": "soloprogressionbalance",
  "displayName": "SoloProgressionBalance",
  "version": "0.4.0",
  "description": "Server-side solo mining, drone, hold, and logistics scaling.",
  "kind": "loader",
  "supportedBackends": [
    "native"
  ],
  "activation": {
    "strategy": "loader_rename"
  },
  "restart": "game_server",
  "compatibility": {
    "evejsVersions": [
      "0.12.9"
    ]
  },
  "settings": {
    "schemaVersion": 1,
    "files": [
      {
        "id": "preferences",
        "base": "mod",
        "path": "settings.json",
        "format": "json"
      }
    ],
    "fields": [
      {
        "id": "enabled",
        "label": "Enable Solo scaling",
        "type": "boolean",
        "default": false,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "enabled"
        ]
      },
      {
        "id": "miningYieldScale",
        "label": "Mining module yield multiplier",
        "type": "number",
        "default": 3,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "miningYieldScale"
        ],
        "minimum": 0.01,
        "maximum": 100
      },
      {
        "id": "miningDroneYieldScale",
        "label": "Mining drone yield multiplier",
        "type": "number",
        "default": 3,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "miningDroneYieldScale"
        ],
        "minimum": 0.01,
        "maximum": 100
      },
      {
        "id": "miningHoldScale",
        "label": "Mining hold multiplier",
        "type": "number",
        "default": 3,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "miningHoldScale"
        ],
        "minimum": 0.01,
        "maximum": 100
      },
      {
        "id": "logisticsCargoScale",
        "label": "Logistics cargo multiplier",
        "type": "number",
        "default": 2,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "logisticsCargoScale"
        ],
        "minimum": 0.01,
        "maximum": 100
      },
      {
        "id": "verbose",
        "label": "Verbose logging",
        "type": "boolean",
        "default": false,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "verbose"
        ],
        "advanced": true
      }
    ]
  },
  "updates": {
    "provider": "github",
    "repository": "Delta007a/EveJS-SoloProgressionBalance",
    "asset": "EveJS-SoloProgressionBalance-{version}.zip",
    "channel": "stable",
    "tagPrefix": "v",
    "preserveFiles": [
      ".env"
    ]
  }
}
